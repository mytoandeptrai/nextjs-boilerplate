# Do not include a trailing slash in URLs.
# Copy to `.env.local` for development.

NEXT_PUBLIC_APP_ENV=development # production | staging | development
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Backend origin. The browser never calls it directly: requests go through the
# Next.js BFF (/api/*), which forwards the access token kept in an httpOnly cookie.
NEXT_PUBLIC_API_URL="https://your-app.com"
