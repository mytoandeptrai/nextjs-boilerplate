# Do not include a trailing slash in URLs.
# Copy to `.env.local` for development. Never commit real values.

NEXT_PUBLIC_APP_ENV=development # production | staging | development
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Supabase (Project settings > API). The publishable key is public; the service role key is a secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy name, used when NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is empty.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Existing public bucket for product, lookbook and guide images.
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET=
# Server only: admin reads / writes and uploads.
SUPABASE_SERVICE_ROLE_KEY=

# Email alert for "home survey" requests (https://resend.com). Empty: the alert is skipped.
RESEND_API_KEY=
# Sender. Resend only allows onboarding@resend.dev until a domain is verified.
QUOTE_EMAIL_FROM=

# Tooling only (supabase db push, never read by the app). Use the session pooler URI:
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# Tooling only (pnpm screenshots): an admin account created with `pnpm admin:create <email> <password>`.
ADMIN_EMAIL=
ADMIN_PASSWORD=
